# ==============================================================================
# Modelo de configuração. ESTE arquivo é versionado; os `.env` reais não.
#
# Copie para `.env` e preencha:  cp .env.example .env
#
# `.env`      → desenvolvimento. É o que o pydantic carrega por padrão
#               (`config.py` declara `env_file=".env"`).
# `.env.prod` → produção. NUNCA é carregado sozinho; precisa ser passado de propósito.
#               A fonte da verdade da produção é o painel do Render, não um arquivo.
#
# Existe uma cópia em `backend/.env` porque `env_file` é relativo ao diretório de
# execução: rodando o uvicorn de dentro de `backend/`, é aquele que vale.
#
# Sem valor, três destas variáveis impedem a aplicação de SUBIR: `config.py` executa
# `Settings()` no import e DATABASE_URL, SECRET_KEY e GEMINI_API_KEY não têm default.
# ==============================================================================

# ---- Banco -------------------------------------------------------------------
# Em dev, o Postgres do docker-compose (`docker compose up -d db`).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=nutri_db
POSTGRES_PORT=5432
# `localhost` para rodar na máquina; o compose sobrescreve para `db` no container.
POSTGRES_HOST=localhost

# OBRIGATÓRIA. Em dev, aponte para o Postgres local — não para produção.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nutri_db

# `production` liga HSTS e desliga /docs, /redoc e /openapi.json.
ENVIRONMENT=development

# ---- Autenticação ------------------------------------------------------------
# OBRIGATÓRIA. Assina os JWT. Use uma chave DIFERENTE em cada ambiente: com a mesma,
# um token gerado na sua máquina é aceito em produção.
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- IA ----------------------------------------------------------------------
# OBRIGATÓRIA para a aplicação subir (o valor pode ser falso se você não for usar IA).
# Google AI Studio. Cardápio, Chef IA e resolução de alimento desconhecido dependem dela.
GEMINI_API_KEY=

# ---- E-mail ------------------------------------------------------------------
# Verificação de conta, recuperação de senha e aviso de vencimento.
# Vazio em dev = e-mail não sai (falha registrada no log). É o padrão seguro:
# com credencial real, rodar um fluxo com o endereço de uma pessoa real a faz receber.
# Único provedor: Brevo (sender único verificado).
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# ---- URLs --------------------------------------------------------------------
# Usada para montar os links dos e-mails. Se ficar em localhost em produção, o
# usuário recebe link para a própria máquina dele. A aplicação avisa no log ao subir.
FRONTEND_URL=http://localhost:5173

# Origens autorizadas no CORS, separadas por vírgula. Deixar localhost em produção
# significa aceitar requisição com credencial de uma origem que qualquer pessoa serve.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Pagamento e legado ------------------------------------------------------
# Sem token do Mercado Pago o fluxo de assinatura não funciona. Use credencial de
# sandbox em desenvolvimento, nunca a de produção.
MERCADO_PAGO_ACCESS_TOKEN=

# Brevo era o provedor de e-mail anterior ao Resend. Mantido por compatibilidade;
# pode ficar vazio.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# ---- Lembretes (push Web) ----------------------------------------------------
# Sem estas quatro a API sobe normalmente: /push responde 503 e o dispatch fica fechado.
# Gere o par de chaves VAPID (precisa de `pip install pywebpush`) e copie as duas linhas:
#   python -c "import base64; from py_vapid import Vapid; from cryptography.hazmat.primitives import serialization as s; v=Vapid(); v.generate_keys(); b=lambda x: base64.urlsafe_b64encode(x).rstrip(b'=').decode(); print('VAPID_PUBLIC_KEY='+b(v.public_key.public_bytes(s.Encoding.X962, s.PublicFormat.UncompressedPoint))); print('VAPID_PRIVATE_KEY='+b(v.private_key.private_numbers().private_value.to_bytes(32,'big')))"
# Cadastre no Render (nunca no repositório): VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY,
# VAPID_SUBJECT e CRON_SECRET. O MESMO CRON_SECRET vai também em GitHub > Settings >
# Secrets and variables > Actions > New repository secret (nome: CRON_SECRET).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do remetente exigido pelo padrão VAPID, ex.: mailto:voce@exemplo.com
VAPID_SUBJECT=
# Segredo do cron. Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CRON_SECRET=
